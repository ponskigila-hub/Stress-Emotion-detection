    st.markdown('</div>', unsafe_allow_html=True)

    st.markdown("<br>", unsafe_allow_html=True)
    c1, c2 = st.columns(2)

    with c1:
        st.markdown('<div class="section-card">', unsafe_allow_html=True)
        st.markdown("##### Perbandingan Before / After")
        sample = emotion_df.sample(6, random_state=42)
        for _, row in sample.iterrows():
            st.markdown(f"""<div style='margin:10px 0;padding:12px 16px;background:#0d0d20;
                border-radius:10px;border:1px solid #1e1e3f;'>
                <div style='font-size:10px;color:#f59e0b;font-family:DM Mono;margin-bottom:4px;'>ORIGINAL</div>
                <div style='color:#aaaacc;font-size:12px;margin-bottom:8px;'>{str(row["text"])[:120]}</div>
                <div style='font-size:10px;color:#22c55e;font-family:DM Mono;margin-bottom:4px;'>CLEANED</div>
                <div style='color:#e0e0ff;font-size:12px;'>{str(row["clean_text"])[:120]}</div>
            </div>""", unsafe_allow_html=True)
        st.markdown('</div>', unsafe_allow_html=True)

    with c2:
        st.markdown('<div class="section-card">', unsafe_allow_html=True)
        st.markdown("##### 🧪 Coba Preprocessing + Slang")
        user_text = st.text_area("Masukkan teks:", height=110,
            placeholder="contoh: gw stress bgt, deadline mulu, literally cant even fr fr")
        use_slang_toggle = st.checkbox("Aktifkan Slang Normalization", value=True)

        if user_text:
            slang_out  = normalize_slang(user_text.lower()) if use_slang_toggle else user_text.lower()
            final_text = clean_text(user_text, use_slang=use_slang_toggle)

            if use_slang_toggle:
                st.markdown(f"""<div style='background:#0a1a30;border:1px solid rgba(99,102,241,0.3);
                    border-radius:10px;padding:12px;margin:8px 0;'>
                    <div style='font-size:10px;color:#6366f1;font-family:DM Mono;margin-bottom:6px;'>SETELAH SLANG NORM.</div>
                    <div style='color:#c8c8ff;font-size:12px;'>{slang_out[:300]}</div>
                </div>""", unsafe_allow_html=True)

            st.markdown(f"""<div style='background:#0a200a;border:1px solid rgba(34,197,94,0.3);
                border-radius:10px;padding:12px;margin:8px 0;'>
                <div style='font-size:10px;color:#22c55e;font-family:DM Mono;margin-bottom:6px;'>HASIL AKHIR (CLEANED)</div>
                <div style='color:#e0e0ff;font-size:12px;'>{final_text if final_text else "(kosong)"}</div>
            </div>""", unsafe_allow_html=True)

            detected = []
            tl = user_text.lower()
            all_slang = {**INDO_SLANG, **ENGLISH_SLANG}
            for slang in sorted(all_slang.keys(), key=len, reverse=True):
                pat = r'(?<![a-zA-Z])' + re.escape(slang) + r'(?![a-zA-Z])'
                if re.search(pat, tl): detected.append(slang)
            if detected:
                pills = "".join([f'<span style="background:rgba(167,139,250,0.15);border:1px solid rgba(167,139,250,0.3);color:#a78bfa;padding:2px 8px;border-radius:6px;font-size:11px;margin:2px;font-family:DM Mono;display:inline-block;">{w}</span>' for w in detected[:15]])
                st.markdown(f"<div style='margin-top:8px;'><span style='font-size:10px;color:#7878aa;'>Slang terdeteksi: </span>{pills}</div>", unsafe_allow_html=True)

        st.markdown("<br>", unsafe_allow_html=True)
        st.markdown("##### Statistik Dataset")
        avg_e = emotion_df["text"].apply(lambda x: len(str(x).split())).mean()
        avg_s = stress_df["text"].apply(lambda x: len(str(x).split())).mean()
        vocab = len(set(" ".join(emotion_df["clean_text"]).split()))
        st.markdown(f"""<div style='display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-top:10px;'>
            <div style='background:#13132a;border:1px solid #2a2a5a;border-radius:12px;padding:14px;text-align:center;'>
                <div style='font-size:10px;color:#7878aa;font-family:DM Mono;'>AVG EMOSI</div>
                <div style='font-size:20px;font-weight:800;color:#a78bfa;'>{avg_e:.0f}</div>
                <div style='font-size:10px;color:#5a5a8a;'>kata/tweet</div>
            </div>
            <div style='background:#13132a;border:1px solid #2a2a5a;border-radius:12px;padding:14px;text-align:center;'>
                <div style='font-size:10px;color:#7878aa;font-family:DM Mono;'>AVG STRES</div>
                <div style='font-size:20px;font-weight:800;color:#6366f1;'>{avg_s:.0f}</div>
                <div style='font-size:10px;color:#5a5a8a;'>kata/post</div>
            </div>
            <div style='background:#13132a;border:1px solid #2a2a5a;border-radius:12px;padding:14px;text-align:center;'>
                <div style='font-size:10px;color:#7878aa;font-family:DM Mono;'>VOCAB</div>
                <div style='font-size:20px;font-weight:800;color:#22c55e;'>{vocab:,}</div>
                <div style='font-size:10px;color:#5a5a8a;'>unik token</div>
            </div>
        </div>""", unsafe_allow_html=True)
        st.markdown('</div>', unsafe_allow_html=True)


# ==========================================
# MODEL TRAINING
# ==========================================
elif page == "🤖  Model Training":
    st.title("🤖 Model Training")
    col_cfg, col_preview = st.columns([1, 1.3])

    with col_cfg:
        st.markdown('<div class="section-card">', unsafe_allow_html=True)
        st.markdown("##### ⚙️ Konfigurasi Training")
        model_name        = st.selectbox("Algoritma",["Logistic Regression","Naive Bayes","Linear SVM"])
        balance_strategy  = st.selectbox("Strategi Balancing",
            ["Random Oversampling","SMOTE","Random Undersampling","SMOTETomek","Tanpa Balancing"])
        tfidf_features    = st.slider("TF-IDF Max Features", 1000, 20000, 10000, 1000)
        test_size         = st.slider("Test Split Ratio", 0.1, 0.4, 0.2, 0.05)
        use_slang_train   = st.checkbox("Pakai Slang Normalization", value=True)

        info_map = {
            "Random Oversampling": ("Menduplikasi sampel minoritas secara acak.","#6366f1"),
            "SMOTE":               ("Membuat sampel sintetis dari interpolasi minoritas.","#a78bfa"),
            "Random Undersampling":("Mengurangi sampel mayoritas secara acak.","#f59e0b"),
            "SMOTETomek":          ("SMOTE + Tomek Links — boundary lebih bersih.","#22c55e"),
            "Tanpa Balancing":     ("Tidak ada balancing.","#ef4444"),
        }
        it, ic = info_map[balance_strategy]
        st.markdown(f"""<div style='background:rgba(99,102,241,0.07);border-left:3px solid {ic};
            border-radius:0 8px 8px 0;padding:10px 14px;margin-top:8px;'>
            <span style='color:#9999cc;font-size:12px;'>{it}</span>
        </div>""", unsafe_allow_html=True)
        train_btn = st.button("🚀 Train Model", use_container_width=True)
        st.markdown('</div>', unsafe_allow_html=True)

    with col_preview:
        st.markdown('<div class="section-card">', unsafe_allow_html=True)
        st.markdown("##### 📊 Preview Distribusi Sebelum & Sesudah Balancing")
        vc_orig = stress_df["stress_label"].value_counts().sort_index()
        if balance_strategy != "Tanpa Balancing":
            try:
                _tf = TfidfVectorizer(max_features=2000)
                _X  = _tf.fit_transform(stress_df["clean_text"])
                _X2, _y2 = apply_balancing(_X, stress_df["stress_label"].values, balance_strategy)
                vc_bal = pd.Series(_y2).value_counts().sort_index()
            except Exception:
                vc_bal = vc_orig
        else:
            vc_bal = vc_orig

        fig, axes = plt.subplots(1, 2, figsize=(9,4))
        for ax, vcd, title in [(axes[0],vc_orig,"Original"),(axes[1],vc_bal,f"Setelah {balance_strategy.split()[0]}")]:
            xl = [LABELS_MAP.get(int(k),str(k)) for k in vcd.index]
            bs = ax.bar(xl, vcd.values, color=BAR_COLORS[:len(vcd)], width=0.5, edgecolor='none')
            ax.spines[["top","right"]].set_visible(False); ax.set_title(title, fontsize=11, pad=8)
            for bar,v in zip(bs,vcd.values):
                ax.text(bar.get_x()+bar.get_width()/2, v+2, f"{int(v):,}", ha='center', fontsize=9, fontweight='bold', color='white')
        fig.tight_layout(pad=2); st.pyplot(fig); plt.close()

        if len(vc_bal) > 1:
            mx, mn = vc_bal.max(), vc_bal.min()
            ratio  = mx/mn if mn > 0 else float('inf')
            bscore = (1-(mx-mn)/mx)*100
            st.markdown(f"""<div style='display:flex;gap:10px;margin-top:10px;flex-wrap:wrap;'>
                <span style='background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.3);
                    color:#4ade80;padding:4px 12px;border-radius:100px;font-size:11px;font-family:DM Mono;'>
                    Ratio: {ratio:.2f}x
                </span>
                <span style='background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.3);
                    color:#4ade80;padding:4px 12px;border-radius:100px;font-size:11px;font-family:DM Mono;'>
                    Balance Score: {bscore:.1f}%
                </span>
            </div>""", unsafe_allow_html=True)
        st.markdown('</div>', unsafe_allow_html=True)

    # ---- TRAINING ----
    if train_btn:
        st.markdown("<br>", unsafe_allow_html=True)
        progress_ph = st.empty()

        TRAIN_STEPS = [
            "Preprocessing data",
            "Fit TF-IDF Vectorizer",
            f"Balancing: {balance_strategy}",
            f"Train: {model_name}",
            "Evaluasi model",
            "Selesai ✓",
        ]

        def draw_progress(done_list, active=None):
            html = '<div class="section-card"><div style="font-size:14px;font-weight:700;color:#e0e0ff;margin-bottom:12px;">Training Progress</div>'
            for s in TRAIN_STEPS:
                if s in done_list:   html += f'<div class="step-row step-done">✅ {s}</div>'
                elif s == active:    html += f'<div class="step-row step-active">⟳ {s}</div>'
                else:                html += f'<div class="step-row">○ {s}</div>'
            return html + '</div>'

        done = []

        progress_ph.markdown(draw_progress(done, TRAIN_STEPS[0]), unsafe_allow_html=True)
        Xe = emotion_df["text"].apply(lambda t: clean_text(t, use_slang_train))
        ye = emotion_df["label"]
        Xs = stress_df["text"].apply(lambda t: clean_text(t, use_slang_train))
        ys = stress_df["stress_label"].values
        done.append(TRAIN_STEPS[0])

        progress_ph.markdown(draw_progress(done, TRAIN_STEPS[1]), unsafe_allow_html=True)
        tfidf = TfidfVectorizer(max_features=tfidf_features, ngram_range=(1,2))
        Xvec  = tfidf.fit_transform(Xs)
        done.append(TRAIN_STEPS[1])

        progress_ph.markdown(draw_progress(done, TRAIN_STEPS[2]), unsafe_allow_html=True)
        try:
            Xr, yr = apply_balancing(Xvec, ys, balance_strategy)
        except Exception as be:
            st.warning(f"Balancing gagal ({be}), pakai data original.")
            Xr, yr = Xvec, ys
        done.append(TRAIN_STEPS[2])

        progress_ph.markdown(draw_progress(done, TRAIN_STEPS[3]), unsafe_allow_html=True)
        Xte, Xve, yte, yve = train_test_split(Xe, ye, test_size=test_size, random_state=42)
        e_pipe = Pipeline([
            ("tfidf", TfidfVectorizer(max_features=tfidf_features, ngram_range=(1,2))),
            ("clf",   build_model(model_name))
        ])
        e_pipe.fit(Xte, yte)
        Xts, Xvs, yts, yvs = train_test_split(Xr, yr, test_size=test_size, random_state=42)
        s_model = build_model(model_name)
        s_model.fit(Xts, yts)
        done.append(TRAIN_STEPS[3])

        progress_ph.markdown(draw_progress(done, TRAIN_STEPS[4]), unsafe_allow_html=True)
        pred_s = s_model.predict(Xvs)
        pred_e = e_pipe.predict(Xve)
        acc_s  = accuracy_score(yvs,  pred_s)
        prec_s = precision_score(yvs, pred_s, average="weighted", zero_division=0)
        rec_s  = recall_score(yvs,   pred_s, average="weighted", zero_division=0)
        f1_s   = f1_score(yvs,       pred_s, average="weighted", zero_division=0)
        acc_e  = accuracy_score(yve,  pred_e)
        done += [TRAIN_STEPS[4], TRAIN_STEPS[5]]
        progress_ph.markdown(draw_progress(done), unsafe_allow_html=True)

        st.session_state.emotion_model = e_pipe
        st.session_state.stress_model  = (s_model, tfidf, use_slang_train)
        st.session_state.last_metrics  = dict(
            acc_s=acc_s, prec_s=prec_s, rec_s=rec_s, f1_s=f1_s, acc_e=acc_e,
            pred_stress=pred_s, y_test_s=yvs, model_name=model_name, balance=balance_strategy)

        st.markdown(f"""
        <div class="bento-grid" style="margin-top:20px;">
            <div class="bento-card" style="--accent:linear-gradient(90deg,#6366f1,#a78bfa)">
                <div class="bento-label">Accuracy</div><div class="bento-value">{acc_s:.1%}</div>
                <div class="bento-sub">stress model</div>
            </div>
            <div class="bento-card" style="--accent:linear-gradient(90deg,#22c55e,#4ade80)">
                <div class="bento-label">Precision</div><div class="bento-value">{prec_s:.1%}</div>
                <div class="bento-sub">weighted avg</div>
            </div>
            <div class="bento-card" style="--accent:linear-gradient(90deg,#f59e0b,#fcd34d)">
                <div class="bento-label">Recall</div><div class="bento-value">{rec_s:.1%}</div>
                <div class="bento-sub">weighted avg</div>
            </div>
            <div class="bento-card" style="--accent:linear-gradient(90deg,#ef4444,#f87171)">
                <div class="bento-label">F1-Score</div><div class="bento-value">{f1_s:.1%}</div>
                <div class="bento-sub">weighted avg</div>
            </div>
        </div>""", unsafe_allow_html=True)

        st.markdown("<br>", unsafe_allow_html=True)
        r1, r2 = st.columns(2)
        with r1:
            st.markdown('<div class="section-card">', unsafe_allow_html=True)
            st.markdown("##### Confusion Matrix")
            cm = confusion_matrix(yvs, pred_s)
            ul = sorted(stress_df["stress_label"].unique())
            tl = [LABELS_MAP.get(int(k),str(k)) for k in ul]
            fig, ax = plt.subplots(figsize=(6,5))
            sns.heatmap(cm, annot=True, fmt="d", cmap="Blues",
                xticklabels=tl[:cm.shape[1]], yticklabels=tl[:cm.shape[0]],
                linewidths=1, linecolor='#111128', annot_kws={"size":14,"color":"white"}, ax=ax)
            ax.set_xlabel("Predicted", fontsize=11); ax.set_ylabel("Actual", fontsize=11)
            fig.tight_layout(); st.pyplot(fig); plt.close()
            st.markdown('</div>', unsafe_allow_html=True)
        with r2:
            st.markdown('<div class="section-card">', unsafe_allow_html=True)
            st.markdown("##### Classification Report")
            report = classification_report(yvs, pred_s, output_dict=True, zero_division=0)
            st.dataframe(pd.DataFrame(report).transpose().round(3), use_container_width=True)
            st.markdown(f"""<div style='margin-top:14px;padding:12px 16px;background:#0a1a0a;
                border:1px solid rgba(34,197,94,0.2);border-radius:10px;'>
                <span style='color:#22c55e;font-size:13px;'>
                    ✓ <b>{model_name}</b> + <b>{balance_strategy}</b> selesai.<br>
                    Emotion accuracy: <b>{acc_e:.1%}</b> | Slang: <b>{'ON' if use_slang_train else 'OFF'}</b>
                </span>
            </div>""", unsafe_allow_html=True)
            st.markdown('</div>', unsafe_allow_html=True)

    elif st.session_state.last_metrics:
        m = st.session_state.last_metrics
        st.markdown(f"""<div style='background:#111128;border:1px dashed #2a2a5a;border-radius:14px;
            padding:18px 24px;margin-top:16px;'>
            <span style='color:#6666aa;font-size:13px;'>
                Model terakhir: <b style='color:#a78bfa'>{m["model_name"]}</b> +
                <b style='color:#a78bfa'>{m["balance"]}</b> —
                Accuracy: <b style='color:#22c55e'>{m["acc_s"]:.1%}</b> |
                F1: <b style='color:#22c55e'>{m["f1_s"]:.1%}</b>
            </span>
        </div>""", unsafe_allow_html=True)


# ==========================================
# PREDICTION
# ==========================================
elif page == "🔮  Prediction":
    st.title("🔮 Stress Prediction")

    model_ready = (st.session_state.emotion_model is not None and st.session_state.stress_model is not None)

    if not model_ready:
        st.markdown("""<div style='background:#1a0f0a;border:1px solid rgba(245,158,11,0.3);
            border-radius:16px;padding:24px;text-align:center;'>
            <div style='font-size:40px;margin-bottom:12px;'>⚠️</div>
            <div style='color:#f59e0b;font-size:16px;font-weight:700;'>Model belum dilatih</div>
            <div style='color:#9999aa;font-size:13px;margin-top:8px;'>
                Pergi ke halaman <b>🤖 Model Training</b> untuk melatih model terlebih dahulu.
            </div>
        </div>""", unsafe_allow_html=True)
    else:
        col_in, col_out = st.columns([1.2, 1])

        with col_in:
            st.markdown('<div class="section-card">', unsafe_allow_html=True)
            st.markdown("##### 📝 Input Teks")

            EXAMPLES = {
                "😌 Normal":      "Hari ini sangat menyenangkan, bs jalan-jalan sm temen dan makan enak bareng",
                "😥 Mild Stress": "banyak tugas deadline minggu ini, gw agak overwhelm tp masih bs handle sih",
                "😫 High Stress": "udah 3 hari ga tidur krn tekanan kerja, literally cant even, burnout bgt fr fr",
            }
            ec1, ec2, ec3 = st.columns(3)
            for col, label in zip([ec1,ec2,ec3], EXAMPLES.keys()):
                with col:
                    if st.button(label, use_container_width=True):
                        st.session_state.example_text = EXAMPLES[label]
                        st.rerun()

            default_val = st.session_state.example_text if st.session_state.example_text else ""
            user_input  = st.text_area("Teks:", value=default_val, height=140,
                placeholder="Ketik atau pilih contoh di atas...", label_visibility="collapsed")

            show_slang_step = st.checkbox("Tampilkan langkah slang normalization", value=False)
            predict_btn     = st.button("🔍 Analisis Teks", use_container_width=True)
            st.markdown('</div>', unsafe_allow_html=True)

        with col_out:
            if predict_btn and user_input.strip():
                _, _, trained_slang = st.session_state.stress_model
                cleaned      = clean_text(user_input, use_slang=trained_slang)
                emotion_pred = st.session_state.emotion_model.predict([cleaned])[0]
                s_model, tfidf, _ = st.session_state.stress_model
                stress_vec   = tfidf.transform([cleaned])
                stress_pred  = int(s_model.predict(stress_vec)[0])

                STRESS_DISPLAY = {
                    0: ("Normal",      "😌","pred-normal","#22c55e"),
                    1: ("Mild Stress", "😥","pred-mild",  "#f59e0b"),
                    2: ("High Stress", "😫","pred-high",  "#ef4444"),
                }
                s_label, s_icon, s_cls, s_color = STRESS_DISPLAY.get(stress_pred,("Unknown","❓","pred-normal","#aaaacc"))

                proba_html = ""
                if hasattr(s_model, "predict_proba"):
                    try:
                        proba = s_model.predict_proba(stress_vec)[0]
                        pb = ""
                        for i,(p,c) in enumerate(zip(proba,BAR_COLORS)):
                            lbl = LABELS_MAP.get(i,str(i))
                            pb += f"""<div style='margin:8px 0;'>
                                <div style='display:flex;justify-content:space-between;margin-bottom:4px;'>
                                    <span style='font-size:11px;color:#9999cc;font-family:DM Mono;'>{lbl}</span>
                                    <span style='font-size:11px;color:{c};font-family:DM Mono;font-weight:700;'>{p:.1%}</span>
                                </div>
                                <div style='background:#1e1e3f;border-radius:100px;height:5px;'>
                                    <div style='background:{c};width:{p*100:.1f}%;height:100%;border-radius:100px;'></div>
                                </div>
                            </div>"""
                        proba_html = f"""<div style='margin-top:14px;padding:14px;background:#0d0d20;
                            border-radius:12px;border:1px solid #1e1e3f;'>
                            <div style='font-size:10px;color:#5555aa;font-family:DM Mono;margin-bottom:8px;'>CONFIDENCE SCORES</div>
                            {pb}</div>"""
                    except Exception:
                        pass

                slang_step_html = ""
                if show_slang_step and trained_slang:
                    normed = normalize_slang(user_input.lower())
                    slang_step_html = f"""<div style='margin-top:12px;padding:12px;background:#0a1020;
                        border-radius:10px;border:1px solid rgba(99,102,241,0.2);'>
                        <div style='font-size:10px;color:#6366f1;font-family:DM Mono;margin-bottom:6px;'>SLANG NORMALIZED</div>
                        <div style='font-size:11px;color:#8888cc;font-family:DM Mono;line-height:1.5;'>{normed[:250]}{"..." if len(normed)>250 else ""}</div>
                    </div>"""

                st.markdown(f"""
                <div class="section-card">
                    <div style='font-size:11px;color:#5555aa;font-family:DM Mono;margin-bottom:14px;'>HASIL ANALISIS</div>
                    <div class="pred-result pred-emotion">
                        <div class="pred-label">EMOSI TERDETEKSI</div>
                        <div class="pred-value">🎭 {emotion_pred.title()}</div>
                    </div>
                    <div class="pred-result {s_cls}" style="margin-top:10px;">
                        <div class="pred-label">LEVEL STRES</div>
                        <div class="pred-value">{s_icon} {s_label}</div>
                    </div>
                    {proba_html}
                    {slang_step_html}
                    <div style='margin-top:12px;padding:10px 14px;background:#0d0d20;
                        border-radius:10px;border:1px solid #1e1e3f;'>
                        <div style='font-size:10px;color:#5555aa;font-family:DM Mono;margin-bottom:4px;'>CLEANED INPUT</div>
                        <div style='font-size:11px;color:#7878aa;font-family:DM Mono;line-height:1.5;'>{cleaned[:200]}{"..." if len(cleaned)>200 else ""}</div>
                    </div>
                </div>""", unsafe_allow_html=True)

            elif predict_btn and not user_input.strip():
                st.warning("Masukkan teks terlebih dahulu.")
            else:
                st.markdown("""<div class="section-card" style="min-height:340px;display:flex;align-items:center;
                    justify-content:center;text-align:center;">
                    <div>
                        <div style='font-size:48px;opacity:0.25;margin-bottom:14px;'>🔮</div>
                        <div style='color:#5555aa;font-size:14px;'>
                            Pilih contoh atau ketik teks,<br>
                            lalu klik <b style='color:#7070cc;'>Analisis Teks</b>
                        </div>
                    </div>
                </div>""", unsafe_allow_html=True)