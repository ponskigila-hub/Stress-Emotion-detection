def normalize_slang(text):
    """
    Normalize Indonesian and English slang/abbreviations.
    Sources: zeroix07/indo-slang-words, MariyaAnjum/genz-slang-dataset,
             acader/genz-alpha-slangs (MIT License)
    """
    text = str(text).lower()
    all_slang = {**INDO_SLANG, **ENGLISH_SLANG}
    for slang, formal in sorted(all_slang.items(), key=lambda x: len(x[0]), reverse=True):
        if not formal:
            continue
        pattern = r'(?<![a-zA-Z])' + re.escape(slang) + r'(?![a-zA-Z])'
        text = re.sub(pattern, ' ' + formal + ' ', text)
    return re.sub(r'\s+', ' ', text).strip()


